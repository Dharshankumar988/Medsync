# ==========================
# MedSync Backend Environment Config
# ==========================

# 1. Database & Infrastructure
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres?ssl=require
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_KEY=your-supabase-service-key

# 2. Authentication
JWT_SECRET_KEY=generate_your_jwt_secret_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. AI Services
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=qwen-2.5-32b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
MEDSYNC_AI_URL=https://dharshan8197-medsync-ai.hf.space
HF_TOKEN=hf_your_huggingface_token
AI_SERVICE_TOKEN=optional_service_token_for_models
AI_TIMEOUT=30

# 4. Blockchain Services
BLOCKCHAIN_MODE=mock
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
BACKEND_PRIVATE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 5. IPFS & Storage
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# 6. CORS & Frontend Configuration
# Update this with the Vercel deployed frontend URL in production
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://your-frontend-deployment.vercel.app"]

# 7. Biometrics
# MUST be exactly 32-byte URL-safe base64-encoded
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BIOMETRIC_ENCRYPTION_KEY=Sn-z5dnqskbOwOTDT3E9GbYW6TR-Y4EAvJY0BvyM1pw=
