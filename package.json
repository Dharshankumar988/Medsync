{
  "name": "medsync",
  "private": true,
  "scripts": {
    "build": "pnpm run -r build",
    "dev": "pnpm run --parallel --stream -r dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.10.4",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "@types/node": "^20.12.0"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@9.15.4"
}
