{
  "name": "medsync",
  "private": true,
  "scripts": {
    "build": "pnpm run -r build",
    "dev": "pnpm run --parallel --stream -r dev",
    "mobile": "pnpm --filter medsync-mobile start",
    "mobile:tunnel": "pnpm --filter medsync-mobile start --tunnel",
    "mobile:android": "pnpm --filter medsync-mobile android",
    "mobile:web": "pnpm --filter medsync-mobile web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "prettier": "^3.0.0",
    "puppeteer": "^25.12.0",
    "turbo": "^2.10.4"
  },
  "overrides": {
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.x"
  },
  "packageManager": "pnpm@10.0.0",
  "dependencies": {
    "pg": "^8.23.0",
    "typescript": "^5.1.3"
  }
}
