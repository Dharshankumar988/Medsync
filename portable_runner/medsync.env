# ─── MedSync Portable Backend Environment ───

# 1. Supabase (Database & Auth)
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# 2. Security & Encryption
JWT_SECRET_KEY=
BIOMETRIC_ENCRYPTION_KEY=

# 3. Groq LLM Services (PULSE Reasoning Engine)
GROQ_API_KEY=
GROQ_MODEL=groq/compound
GROQ_FALLBACK_MODEL=groq/compound-mini

# 4. HF Space #2 (Diagnostic AI)
MEDSYNC_AI_URL=
MEDSYNC_AI_TOKEN=

# 5. API Configuration
# Change this to your Cloudflare Tunnel URL when deploying, or leave as localhost for local testing.
# Example: https://my-tunnel.trycloudflare.com
CORS_ORIGINS=http://localhost:3000
