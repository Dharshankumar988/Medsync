# ============================================
# MedSync Portable Runner Configuration (.env.example)
# ============================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# NEVER commit .env with real secrets to Git.

# --- Database (auto-provided by docker-compose, or override with external Postgres) ---
DATABASE_URL=postgresql://medsync:medsync_dev_pass@db:5432/medsync
POSTGRES_USER=medsync
POSTGRES_PASSWORD=medsync_dev_pass
POSTGRES_DB=medsync

# --- Supabase (Storage & Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_STORAGE_BUCKET=medical-records

# --- Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- SMTP & Brevo Email (Patient Email OTP Verification & Password Reset) ---
# Brevo free tier: 300 emails/day, no credit card required.
# In Brevo Dashboard: Settings -> SMTP & API -> SMTP Keys -> Generate.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_user@smtp-brevo.com
SMTP_PASSWORD=your_brevo_smtp_password_here
SMTP_FROM=MedSync Healthcare <no-reply@medsync.health>
SMTP_TLS=true
SMTP_SSL=false
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRE_MINUTES=5
OTP_EXPIRE_MINUTES=5

# --- AI & LLM Service ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- MedSync AI Service (HuggingFace) ---
MEDSYNC_AI_URL=https://dharshan8197-medsync-ai.hf.space
HF_UNIFIED_SPACE_URL=https://dharshan8197-medsync-ai.hf.space
HF_TOKEN=your_huggingface_token_here
MEDSYNC_AI_TOKEN=your_ai_service_token_here
AI_TIMEOUT=30
HF_MODEL_REPO_ID=Dharshankumar988/medsync-ai-weights
AI_SERVICE_TOKEN=your_ai_service_token_here

# --- Blockchain Configuration ---
# BLOCKCHAIN_MODE=mock for local simulation, production for live Polygon Amoy
BLOCKCHAIN_MODE=production
BLOCKCHAIN_NETWORK=amoy
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
BACKEND_PRIVATE_KEY=your_backend_wallet_private_key_here
MEDSYNC_WALLET_ADDRESS=your_public_wallet_address_here

# --- Smart Contract Registry Addresses (Polygon Amoy Testnet) ---
PATIENT_REGISTRY_ADDRESS=0x9Dcd620f006555ffFA072d2280ef47506C5Da2A3
DOCTOR_REGISTRY_ADDRESS=0x260d8C75009B62009aA2762c1d76d8daAeA1A7A9
PHARMACY_REGISTRY_ADDRESS=0x50dc448bf7260f736A0A3a10151Ccb1a495d3BE9
RECORD_REGISTRY_ADDRESS=0xfC15AA7EF7759dAEF6C9d3dfB6EEc30DC4783104
MEDICALRECORDREGISTRY_ADDRESS=0xfC15AA7EF7759dAEF6C9d3dfB6EEc30DC4783104
PRESCRIPTION_REGISTRY_ADDRESS=0x94013b71F9A3eEbCdbcD11fE460E8E9253916A6D
CONSENT_MANAGER_ADDRESS=0x755F2DBB9Caaa78Eac77fF3115F92984BAc37e52
CONSENTMANAGEMENT_ADDRESS=0x755F2DBB9Caaa78Eac77fF3115F92984BAc37e52

# --- IPFS & Decentralized Storage ---
PINATA_JWT=your_pinata_jwt_here
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Biometric & Encryption ---
BIOMETRIC_ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# --- Frontend & CORS ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://medsync-web.vercel.app

# --- Remote Ngrok Tunnel (Optional) ---
MEDSYNC_API_HOSTNAME=
BACKEND_NGROK_URL=
BACKEND_NGROK_AUTHTOKEN=
