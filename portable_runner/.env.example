# ============================================
# MedSync Portable Runner Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# NEVER commit this file to Git with real values.

# --- Database (auto-provided by docker-compose, override if using external DB) ---
DATABASE_URL=postgresql://medsync:medsync_dev_pass@db:5432/medsync
POSTGRES_USER=medsync
POSTGRES_PASSWORD=medsync_dev_pass
POSTGRES_DB=medsync

# --- Supabase (optional - only needed if using Supabase auth) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI / LLM ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- MedSync AI Service (HuggingFace) ---
MEDSYNC_AI_URL=
HF_UNIFIED_SPACE_URL=
HF_TOKEN=
MEDSYNC_AI_TOKEN=
AI_TIMEOUT=30
HF_MODEL_REPO_ID=
AI_SERVICE_TOKEN=

# --- Blockchain (set BLOCKCHAIN_MODE=production for live Polygon testnet) ---
# BLOCKCHAIN_MODE=mock: Simulated blockchain - no real transactions, shows degraded status
# BLOCKCHAIN_MODE=production: Full blockchain functionality with real transactions
# Default is mock for development/testing
BLOCKCHAIN_MODE=production
BLOCKCHAIN_NETWORK=amoy
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY
BACKEND_PRIVATE_KEY=YOUR_BACKEND_PRIVATE_KEY
MEDSYNC_WALLET_ADDRESS=YOUR_WALLET_ADDRESS

# --- Contract Addresses (auto-loaded from deployment artifacts when BLOCKCHAIN_MODE=amoy) ---
PATIENT_REGISTRY_ADDRESS=
DOCTOR_REGISTRY_ADDRESS=
PHARMACY_REGISTRY_ADDRESS=
RECORD_REGISTRY_ADDRESS=
PRESCRIPTION_REGISTRY_ADDRESS=
CONSENT_MANAGER_ADDRESS=

# --- IPFS / Pinata ---
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Biometric & Face Verification ---
BIOMETRIC_ENCRYPTION_KEY=Sn-z5dnqskbOwOTDT3E9GbYW6TR-Y4EAvJY0BvyM1pw=
FACE_SERVICE_NGROK_URL=
FACE_SERVICE_NGROK_AUTHTOKEN=
FACE_VERIFICATION_URL=
FACE_VERIFICATION_AUTH_TOKEN=

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Ngrok (optional - for exposing backend to the internet) ---
MEDSYNC_API_HOSTNAME=
BACKEND_NGROK_URL=
BACKEND_NGROK_AUTHTOKEN=

BIOMETRIC_ENCRYPTION_KEY=Sn-z5dnqskbOwOTDT3E9GbYW6TR-Y4EAvJY0BvyM1pw=