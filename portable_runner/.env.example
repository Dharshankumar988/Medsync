# ═══════════════════════════════════════════════════════════════
# MedSync Portable Runner — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials.

# ── Database (REQUIRED) ──
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
JWT_SECRET_KEY=
SUPABASE_JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=

# ── AI / LLM (REQUIRED for PULSE AI chat) ──
GROQ_API_KEY=
GROQ_MODEL=groq/compound
GROQ_FALLBACK_MODEL=groq/compound-mini

# ── Hugging Face (REQUIRED for medical image analysis) ──
MEDSYNC_AI_URL=
HF_UNIFIED_SPACE_URL=
HF_TOKEN=
MEDSYNC_AI_TOKEN=
AI_TIMEOUT=

# ── Blockchain ──
# mock        = portable/local mode — no blockchain RPC connection required
# production  = requires a reachable blockchain RPC node and deployed contracts
# real        = alias for production
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_NETWORK=amoy
POLYGON_RPC_URL=
BACKEND_PRIVATE_KEY=

# ── Contract Addresses (only needed when BLOCKCHAIN_MODE=production) ──
DOCTOR_REGISTRY_ADDRESS=
PHARMACY_REGISTRY_ADDRESS=
RECORD_REGISTRY_ADDRESS=
PRESCRIPTION_REGISTRY_ADDRESS=
CONSENT_MANAGER_ADDRESS=
AUDIT_LOGGER_ADDRESS=
PINATA_JWT=

# ── Misc ──
IPFS_GATEWAY=
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=
BIOMETRIC_ENCRYPTION_KEY=
HF_MODEL_REPO_ID=
AI_SERVICE_TOKEN=
MEDSYNC_API_HOSTNAME=

# ── Ngrok Configuration (Optional) ──
# Enter the full URL from your Ngrok dashboard (e.g., https://your-name.ngrok-free.dev)
NGROK_URL=
# Enter your Ngrok Auth Token (only required on first run)
NGROK_AUTHTOKEN=
